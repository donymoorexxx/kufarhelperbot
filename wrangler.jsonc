{
  "name": "kufarhelperbot",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "kufar-bot-db" }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
